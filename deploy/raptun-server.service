[Unit]
Description=Raptun QUIC tunnel server
Documentation=https://github.com/your-org/raptun
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raptun
Group=raptun

# PSK and any future secrets live here; file must be chmod 640, owned root:raptun.
EnvironmentFile=/etc/raptun/env

ExecStart=/usr/local/bin/raptun-server --config /etc/raptun/raptun-server.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Harden the process: no new privileges, read-only filesystem except /etc/raptun.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

# Allow binding low ports if listen is < 1024 (remove if using port >= 1024).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
